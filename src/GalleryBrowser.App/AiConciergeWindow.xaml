<Window x:Class="GalleryBrowser.AiConciergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIコンシェルジュ · 個人用実験版"
        Width="520"
        Height="800"
        MinWidth="460"
        MinHeight="560"
        WindowStartupLocation="Manual"
        Icon="Assets/GalleryBrowser.ico"
        Background="#151B24"
        Foreground="#EDF3FC">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#D9E2EF" />
      <Setter Property="Background" Value="#273244" />
      <Setter Property="BorderBrush" Value="#46566E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#334258" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#B7E641" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#53647C" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Margin="2,1"
                  Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     IsDirectionReversed="True"
                     Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand"
                                Focusable="False"
                                Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb"
                         MinHeight="30"
                         Background="{TemplateBinding Foreground}">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="#71839D" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="#B7E641" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand"
                                Focusable="False"
                                Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter TargetName="ScrollThumb"
                        Property="MinWidth"
                        Value="30" />
                <Setter TargetName="ScrollThumb"
                        Property="MinHeight"
                        Value="0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#A9B5C8" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="CheckBorder"
                      Width="16"
                      Height="16"
                      VerticalAlignment="Center"
                      Background="#151E2B"
                      BorderBrush="#53647C"
                      BorderThickness="1"
                      CornerRadius="4">
                <Path x:Name="CheckMark"
                      Width="10"
                      Height="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 1,4 L 4,7 L 9,1"
                      Stroke="#17200B"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="2"
                      Stretch="Fill"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="7,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBorder"
                        Property="Background"
                        Value="#243246" />
                <Setter TargetName="CheckBorder"
                        Property="BorderBrush"
                        Value="#91A5C0" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBorder"
                        Property="Background"
                        Value="#B7E641" />
                <Setter TargetName="CheckBorder"
                        Property="BorderBrush"
                        Value="#D2F47A" />
                <Setter TargetName="CheckMark"
                        Property="Visibility"
                        Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CheckBorder"
                        Property="BorderBrush"
                        Value="#D2F47A" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Foreground" Value="#D9E2EF" />
      <Setter Property="Background" Value="#1B2533" />
      <Setter Property="BorderBrush" Value="#46566E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MaxDropDownHeight" Value="320" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                  <Path Grid.Column="1"
                        Width="8"
                        Height="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 4 4 L 8 0 Z"
                        Fill="#9DACC1"
                        Stretch="Fill" />
                </Grid>
              </Border>
              <ToggleButton x:Name="DropDownToggle"
                            Background="Transparent"
                            BorderThickness="0"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen,
                                                RelativeSource={RelativeSource TemplatedParent},
                                                Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="Fade">
                <Border MinWidth="{Binding PlacementTarget.ActualWidth,
                                           ElementName=PART_Popup}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Margin="0,3,0,0"
                        Padding="2"
                        Background="#151E2B"
                        BorderBrush="#53647C"
                        BorderThickness="1"
                        CornerRadius="7">
                  <ScrollViewer CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="#243246" />
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#71839D" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="ComboBorder" Property="Background" Value="#243246" />
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#B7E641" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.5" />
                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Foreground" Value="#D9E2EF" />
      <Setter Property="Background" Value="#1B2533" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#334258" />
                <Setter Property="Foreground" Value="#EDF3FC" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#455A2B" />
                <Setter Property="Foreground" Value="#E8F8B8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="15,12"
            Background="#1D2430"
            BorderBrush="#354154"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="40"
                Height="40"
                Margin="0,0,11,0"
                Background="#283641"
                BorderBrush="#8FB23A"
                BorderThickness="1"
                CornerRadius="12">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="21"
                     Foreground="#C7EC67"
                     Text="✦" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontSize="15"
                     FontWeight="Bold"
                     Text="AIコンシェルジュ" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#91A0B5"
                     Text="Codex · 個人用実験版" />
        </StackPanel>
        <Button x:Name="ResetButton"
                Grid.Column="2"
                Width="72"
                Height="34"
                Padding="6"
                Click="OnResetClick"
                Content="リセット" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Padding="14,8"
            Background="#121923"
            BorderBrush="#2C3748"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ContextLabel"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="#C7EC67"
                   TextTrimming="CharacterEllipsis" />
        <CheckBox x:Name="ShareContextCheckBox"
                  Grid.Column="1"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"
                  Foreground="#A9B5C8"
                  FontSize="11"
                  IsChecked="True"
                  Content="現在画面を共有" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="MessageScrollViewer"
                  Grid.Row="2"
                  Padding="15,16,15,8"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="MessagePanel" />
    </ScrollViewer>

    <Border x:Name="StatusBorder"
            Grid.Row="3"
            Margin="13,2,13,8"
            Padding="10,8"
            Background="#25354A"
            BorderBrush="#49617E"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
      <TextBlock x:Name="StatusText"
                 FontSize="11"
                 Foreground="#BED0E7"
                 TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="4"
            Margin="12,0,12,8"
            Background="#101722"
            BorderBrush="#46566E"
            BorderThickness="1"
            CornerRadius="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="InputTextBox"
                 Grid.Row="0"
                 MinHeight="78"
                 MaxHeight="190"
                 Padding="11,9"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 Background="Transparent"
                 BorderThickness="0"
                 CaretBrush="#EDF3FC"
                 Foreground="#EDF3FC"
                 FontFamily="Segoe UI"
                 FontSize="13"
                 MaxLength="16000"
                 PreviewKeyDown="OnInputPreviewKeyDown"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
        <Grid Grid.Row="1" Margin="8,3,7,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"
                      Margin="0,0,8,0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <ComboBox x:Name="ModelComboBox"
                      Width="145"
                      Margin="0,0,6,0"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id"
                      SelectionChanged="OnModelSelectionChanged"
                      ToolTip="次のメッセージから使用するモデル" />
            <ComboBox x:Name="ReasoningComboBox"
                      Width="104"
                      Margin="0,0,6,0"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectionChanged="OnReasoningSelectionChanged"
                      ToolTip="自動は通常の依頼を送信内容ごとに判定します。属性推論は作品ごとに仕分け、文字情報は中、画像判断が必要な作品は高を使用します" />
            <ComboBox x:Name="ServiceTierComboBox"
                      Width="92"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectionChanged="OnServiceTierSelectionChanged"
                      ToolTip="次のメッセージから使用する速度。自動では変更されません" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="StopButton"
                    Width="62"
                    Height="32"
                    Margin="0,0,6,0"
                    Padding="5"
                    Background="#542D35"
                    BorderBrush="#B75A67"
                    Click="OnStopClick"
                    Content="停止"
                    Visibility="Collapsed" />
            <Button x:Name="SendButton"
                    Width="62"
                    Height="32"
                    Padding="5"
                    Background="#A8CE39"
                    BorderBrush="#C9ED69"
                    Foreground="#17200B"
                    FontWeight="Bold"
                    Click="OnSendClick"
                    Content="送信" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <TextBlock Grid.Row="5"
               Margin="10,0,10,10"
               HorizontalAlignment="Center"
               FontSize="10"
               Foreground="#65758B"
               Text="Enterで送信 · Shift+Enterで改行 · モデル・推論・速度は次のメッセージから反映" />
  </Grid>
</Window>
