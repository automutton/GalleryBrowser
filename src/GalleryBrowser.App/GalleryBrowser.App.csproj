<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>GalleryBrowser</AssemblyName>
    <RootNamespace>GalleryBrowser</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>GalleryBrowser</Product>
    <ApplicationIcon>Assets\GalleryBrowser.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\GalleryBrowser.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <Target Name="BuildWebUi" BeforeTargets="Build" Condition="'$(SkipWebUiBuild)' != 'true'">
    <PropertyGroup>
      <WebProjectDir>$(MSBuildProjectDirectory)\..\GalleryBrowser.Web</WebProjectDir>
    </PropertyGroup>
    <Exec WorkingDirectory="$(WebProjectDir)" Command="npm install" Condition="!Exists('$(WebProjectDir)\node_modules')" />
    <Exec WorkingDirectory="$(WebProjectDir)" Command="npm run build" />
  </Target>

  <Target Name="CopyWebUiToOutput" AfterTargets="BuildWebUi" Condition="'$(SkipWebUiBuild)' != 'true'">
    <ItemGroup>
      <WebUiOutputFiles Include="$(WebProjectDir)\dist\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WebUiOutputFiles)"
      DestinationFiles="@(WebUiOutputFiles->'$(OutDir)webui\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWebUiToPublish" AfterTargets="Publish" Condition="'$(SkipWebUiBuild)' != 'true'">
    <ItemGroup>
      <WebUiPublishFiles Include="$(MSBuildProjectDirectory)\..\GalleryBrowser.Web\dist\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WebUiPublishFiles)"
      DestinationFiles="@(WebUiPublishFiles->'$(PublishDir)webui\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
